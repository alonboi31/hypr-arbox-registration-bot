ARBOX_EMAIL=
ARBOX_PASSWORD=
TZ=Asia/Jerusalem
UI_USER=admin
UI_PASSWORD=change-me-to-something-long
NTFY_TOPIC=
# Studio ids (from the app's traffic; defaults are HYPR White City)
ARBOX_LOCATION_ID=48
ARBOX_BOX_ID=59
# Optional: pin the membership used for booking (default: auto-pick active plan)
ARBOX_MEMBERSHIP_USER_ID=
# 1 = log what would be booked, but do not send booking requests (use for first run)
DRY_RUN=1
# 1 = fake classes, no Arbox needed
ARBOX_MOCK=0
# Optional: email a calendar invite for every confirmed booking (and a cancellation if you cancel).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-char App Password>.
CALENDAR_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
